<?xml version="1.0" encoding="utf-8"?>
<!-- Linux icons bring their own shape: show them whole inside the launcher's. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/icon_background" />
    <foreground>
        <inset android:drawable="@drawable/linux_icon" android:inset="25%" />
    </foreground>
</adaptive-icon>
