<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Lets the compositor open a window when a Linux app maps a toplevel
         while none of our windows is in front (background activity start). -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- The Debian VM (VmLauncher). Development permissions: granted with
         adb shell pm grant, no root. -->
    <uses-permission android:name="android.permission.MANAGE_VIRTUAL_MACHINE" />
    <uses-permission android:name="android.permission.USE_CUSTOM_VIRTUAL_MACHINE" />
    <!-- The VM's network (a TAP interface). -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Held by window activities, here and in the stub apps (same signing key). -->
    <permission
        android:name="dev.awb.permission.WINDOWS"
        android:protectionLevel="signature" />

    <!-- The stub apps' window activities, looked up by Linux app id. -->
    <queries>
        <intent>
            <action android:name="dev.awb.action.TOPLEVEL" />
        </intent>
    </queries>

    <application
        android:name=".AwbApp"
        android:label="@string/app_name"
        android:icon="@android:drawable/sym_def_app_icon"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- One task per Wayland toplevel whose Linux app has no stub app.
             Resizing a desktop window must not recreate the activity, hence
             the configChanges list. -->
        <activity
            android:name="dev.awb.window.ToplevelActivity"
            android:exported="false"
            android:documentLaunchMode="always"
            android:resizeableActivity="true"
            android:excludeFromRecents="false"
            android:theme="@style/Toplevel"
            android:configChanges="screenSize|smallestScreenSize|screenLayout|orientation|density|keyboard|keyboardHidden|navigation|uiMode|fontScale|layoutDirection|colorMode|touchscreen|fontWeightAdjustment" />

        <service
            android:name=".ToplevelService"
            android:exported="true"
            android:permission="dev.awb.permission.WINDOWS">
            <intent-filter>
                <action android:name="dev.awb.action.TOPLEVEL_SESSION" />
            </intent-filter>
        </service>

        <service
            android:name=".WaylandService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Wayland compositor serving Linux apps" />
        </service>
    </application>
</manifest>
